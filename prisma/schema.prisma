generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(cuid()) @db.VarChar(25)
  name                  String?            @db.VarChar(50)
  email                 String?            @unique @db.VarChar(255)
  image                 String?            @db.Text
  username              String?            @unique @db.VarChar(30)
  bio                   String?            @db.VarChar(120)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  consentedAt           DateTime?
  consentVersion        String?            @db.VarChar(20)
  accounts              Account[]
  collections           Collection[]       @relation("UserCollections")
  collectionMemberships CollectionMember[] @relation("CollectionMembers")
  comments              Comment[]
  following             Follow[]           @relation("UserFollowing")
  followers             Follow[]           @relation("UserFollowers")
  likes                 Like[]
  saves                 Save[]
  sessions              Session[]
  skips                 Skip[]
  spots                 Spot[]             @relation("UserSpots")
  visits                Visit[]

  @@index([name])
  @@index([username])
}

model Account {
  id                String  @id @default(cuid()) @db.VarChar(25)
  userId            String  @db.VarChar(25)
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(50)
  scope             String? @db.VarChar(255)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(255)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid()) @db.VarChar(25)
  sessionToken String   @unique @db.VarChar(255)
  userId       String   @db.VarChar(25)
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String   @db.VarChar(255)
  token      String   @unique @db.VarChar(255)
  expires    DateTime

  @@unique([identifier, token])
}

/// ---------- Exploree doména ----------
model Spot {
  id          String           @id @default(cuid()) @db.VarChar(25)
  title       String           @db.VarChar(150)
  slug        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(500)
  lat         Float
  lng         Float
  city        String?          @db.VarChar(100)
  country     String?          @db.VarChar(100)
  coverUrl    String?          @db.Text
  image       String           @db.Text
  tags        String           @db.LongText
  authorId    String           @db.VarChar(25)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  collections CollectionSpot[]
  comments    Comment[]
  likes       Like[]
  saves       Save[]
  skips       Skip[]
  author      User             @relation("UserSpots", fields: [authorId], references: [id])
  visits      Visit[]

  @@index([authorId])
  @@index([createdAt])
  @@index([lat, lng])
  @@fulltext([title, city, country])
}

model Collection {
  id        String             @id @default(cuid()) @db.VarChar(25)
  name      String             @db.VarChar(32)
  slug      String             @db.VarChar(50)
  userId    String             @db.VarChar(25)
  isPublic  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation("UserCollections", fields: [userId], references: [id])
  members   CollectionMember[]
  spots     CollectionSpot[]

  @@unique([userId, name])
  @@unique([userId, slug])
  @@index([userId])
}

model CollectionMember {
  id           String     @id @default(cuid()) @db.VarChar(25)
  collectionId String     @db.VarChar(25)
  userId       String     @db.VarChar(25)
  role         String     @default("editor") @db.VarChar(20)
  status       String     @default("pending") @db.VarChar(20)
  invitedAt    DateTime   @default(now())
  respondedAt  DateTime?
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation("CollectionMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([userId, status])
}

model CollectionSpot {
  collectionId String     @db.VarChar(25)
  spotId       String     @db.VarChar(25)
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  spot         Spot       @relation(fields: [spotId], references: [id], onDelete: Cascade)

  @@id([collectionId, spotId])
  @@index([spotId])
}

model Like {
  userId    String   @db.VarChar(25)
  spotId    String   @db.VarChar(25)
  createdAt DateTime @default(now())
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, spotId])
  @@index([spotId])
}

model Save {
  userId    String   @db.VarChar(25)
  spotId    String   @db.VarChar(25)
  createdAt DateTime @default(now())
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, spotId])
  @@index([spotId])
}

model Skip {
  userId    String   @db.VarChar(25)
  spotId    String   @db.VarChar(25)
  createdAt DateTime @default(now())
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, spotId])
  @@index([spotId])
}

model Visit {
  id     String   @id @default(cuid()) @db.VarChar(25)
  userId String   @db.VarChar(25)
  spotId String   @db.VarChar(25)
  when   DateTime @default(now())
  note   String?  @db.VarChar(280)
  spot   Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, when])
  @@index([spotId, when])
}

model Follow {
  followerId  String   @db.VarChar(25)
  followingId String   @db.VarChar(25)
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Comment {
  id        String   @id @default(cuid()) @db.VarChar(25)
  text      String   @db.VarChar(500)
  userId    String   @db.VarChar(25)
  spotId    String   @db.VarChar(25)
  createdAt DateTime @default(now())
  spot      Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spotId, createdAt])
  @@index([userId])
}
